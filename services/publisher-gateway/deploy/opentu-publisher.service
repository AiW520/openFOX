[Unit]
Description=OpenTu publisher model gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opentu-publisher
Group=opentu-publisher
WorkingDirectory=/opt/opentu-publisher/current
EnvironmentFile=/etc/opentu-publisher.env
ExecStart=/usr/local/bin/node services/publisher-gateway/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/opentu-publisher
UMask=0077
MemoryMax=768M

[Install]
WantedBy=multi-user.target
